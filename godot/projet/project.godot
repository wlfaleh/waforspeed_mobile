; WaForSpeed — prototype Godot 4.4.1 (WFS-610) : comparaison de moteur. Rendu « Mobile » (Vulkan), le même que vise un téléphone.
config_version=5

[application]
config/name="WaForSpeed Godot (prototype)"
run/main_scene="res://principal.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icone.png"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]
pointing/emulate_touch_from_mouse=true

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=0
scaling_3d/mode=1
scaling_3d/scale=0.75
mesh_lod/lod_change/threshold_pixels=2.0
textures/default_filters/anisotropic_filtering_level=2
lights_and_shadows/directional_shadow/size=2048
; allègement (essai du téléphone, 12 img/s) : 3D en 75 % de la définition puis FSR 1, pas de MSAA, ombre unique, sans halo
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
textures/vram_compression/import_etc2_astc=true
